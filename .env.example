# Copy to .env.local for `npm run dev`. These two are public (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used for canonical URLs, sitemap and login redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MLS/DDF listings — separate Supabase project, read-only
NEXT_PUBLIC_MLS_SUPABASE_URL=https://YOUR-MLS-PROJECT-REF.supabase.co
NEXT_PUBLIC_MLS_SUPABASE_ANON_KEY=your-mls-anon-key
