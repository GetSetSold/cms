# Set in production with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are provided automatically)
ALLOWED_ORIGINS=https://www.yourdomain.com,http://localhost:3000
DEFAULT_COUNTRY_CODE=1
CRON_SECRET=generate-a-long-random-string
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+10000000000
TWILIO_WEBHOOK_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/sms-inbound
RESEND_API_KEY=
EMAIL_FROM=Your Company <hello@yourdomain.com>
# Optional Cloudflare Turnstile spam check
TURNSTILE_SECRET=
